        "emailFormat": "text",
        "text": "=Kunde: {{ $json.body.kunde }}\nSorte: {{ $json.body.sorte }}\nMenge: {{ $json.body.kg }} kg\n\nEingetragen von OpenClaw.",
        "options": {}
      },
      "name": "Mail an die Rösterei",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [240, 0],
